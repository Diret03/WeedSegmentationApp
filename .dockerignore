# 🚫 .dockerignore - Archivos excluidos del contexto de Docker

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Logs
*.log
logs/

# Archivos temporales
*.tmp
*.temp
.cache/

# Archivos de sistema
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de resultados (se crearán en el contenedor)
uploads/*
results/*
!uploads/.gitkeep
!results/.gitkeep

# Archivos de documentación y desarrollo
README.md
LICENSE
.github/
docs/
screenshots/

# Archivos de configuración local
.env
.env.local
config.local.py

# Archivos de backup
*.bak
*.backup
