# Copy to .env and adjust as needed. Every value below is the default.

# Model
MODEL_PATH=models/weed_segmentation_S-TTA.pth
# Serve hand-drawn placeholder masks when the model cannot load.
# Leave off in production: it makes the app return fake segmentations.
DEMO_MODE=0

# Server
HOST=0.0.0.0
PORT=5000

# Uploads and results
UPLOAD_FOLDER=uploads
RESULTS_FOLDER=results
MAX_UPLOAD_MB=8
MAX_IMAGE_DIM=256
MIN_IMAGE_DIM=32
# Result images older than this are deleted on the next upload. 0 disables cleanup.
RESULT_TTL_MINUTES=60

# Logging
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Set to "production" for JSON console output
FLASK_ENV=development

# Inference threads used by PyTorch
OMP_NUM_THREADS=4
